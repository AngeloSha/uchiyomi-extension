<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- What marks an APK as an extension. Without it the loader never looks inside. -->
    <uses-feature android:name="tachiyomi.extension" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Tachiyomi: Uchiyomi">
        <meta-data android:name="tachiyomix.name" android:value="Uchiyomi" />
        <meta-data android:name="tachiyomi.extension.class" android:value=".UchiyomiFactory" />
        <meta-data android:name="tachiyomi.extension.nsfw" android:value="0" />
        <meta-data android:name="tachiyomix.contentWarning" android:value="0" />
        <meta-data android:name="tachiyomix.extensionLib" android:value="${extLib}" />
    </application>
</manifest>
